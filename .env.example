# Base URL the app calls the CraftCV API on.
#
# Leave it unset for the normal case. The default is the relative path /api,
# which nginx proxies to the Django backend on the same host, so the browser
# talks to whatever origin served the page. Nothing needs to know the server's
# address - which is what keeps the app working after the sandbox restarts on
# a new public IP.
#
# Set this only when the API is on a different origin, for example running the
# frontend with `npm run dev` against a remote backend:
#
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api
